# Auto-generated by Omni Studios — OTEL collector config
# Source this file before starting your server: source .env.omni && <your-start-command>
# In external server mode, new terminals opened in the Omni IDE extension already have these variables (any shell, including PowerShell).
export AGENT_OBSERVABILITY_ENABLED=true
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:50630
export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
export OTEL_TRACES_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=none
export OTEL_METRICS_EXPORTER=none
export OTEL_SERVICE_NAME="sample_repo_group"
export OTEL_RESOURCE_ATTRIBUTES="omni.workspace.path=d:\sample_repo_group"
export OTEL_PYTHON_DISTRO=aws_distro
export OTEL_PYTHON_CONFIGURATOR=aws_configurator
